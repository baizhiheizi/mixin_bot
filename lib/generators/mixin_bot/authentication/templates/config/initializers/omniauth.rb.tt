# frozen_string_literal: true

require "omniauth"

Rails.application.config.middleware.use OmniAuth::Builder do
  provider :mixin,
           ENV.fetch("MIXIN_CLIENT_ID", nil),
           ENV.fetch("MIXIN_CLIENT_SECRET", nil),
           setup: lambda { |env|
             client_id = ENV["MIXIN_CLIENT_ID"]
             client_secret = ENV["MIXIN_CLIENT_SECRET"]

             if client_id.blank? || client_secret.blank?
               raise ArgumentError, "Missing Mixin OAuth credentials: set MIXIN_CLIENT_ID and MIXIN_CLIENT_SECRET"
             end

             env["omniauth.strategy"].options[:client_id] = client_id
             env["omniauth.strategy"].options[:client_secret] = client_secret
           }
end
